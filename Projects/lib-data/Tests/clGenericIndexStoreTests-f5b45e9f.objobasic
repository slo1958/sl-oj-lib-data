Class clGenericIndexStoreTests Inherits TestCase
    Public Sub Test_001_StringKey()
    Assert.True(True)


    Var index As New clGenericIndexStore(Of String)

    index.AddIndexEntry("AAA", 1)
    index.AddIndexEntry("BBB", 3)
    index.AddIndexEntry("CCC", 5)
    index.AddIndexEntry("AAA", 1)
    index.AddIndexEntry("AAA", 10)
    index.AddIndexEntry("BBB", 30)
    index.AddIndexEntry("CCC", 50)
    index.AddIndexEntry("BBB", 70)


    Var res_AAA() As Integer = index.GetRowIndexes("AAA")
    Var res_BBB() As Integer = index.GetRowIndexes("BBB")
    Var res_CCC() As Integer = index.GetRowIndexes("CCC")
    Var res_DDD() As Integer = index.GetRowIndexes("DDD")

    Var exp_AAA() As Integer = [1, 10]
    Var exp_BBB() As Integer = [3, 30, 70]
    Var exp_CCC() As Integer = [5, 50]
    Var exp_DDD() As Integer

    assert.equal(2, res_AAA.Count)
    assert.equal(3, res_BBB.Count)
    assert.equal(2, res_CCC.Count)
    assert.equal(0, res_DDD.Count)

    assert.equal(exp_AAA, res_AAA)
    assert.equal(exp_BBB, res_BBB)
    assert.equal(exp_CCC, res_CCC)
    assert.equal(exp_DDD, res_DDD)

    End Sub
End Class