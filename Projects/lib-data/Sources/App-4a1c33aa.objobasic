Class App Inherits DesktopApplication

    Event Opening(args() As String)

    CheckGroupBy()

    End Event
    Public Function DoSum(p() As Double) As Double

    Var s As Double = 0

    For Each v As Double In p
      s += v

    Next

    Return s

    End Function
    Public Sub TestAggreg()


    Var top() As Array(Of Double)

    For i As Integer = 0 To 2
      Var vv() As Double
      top.Append(vv)

    Next

    top[0].AppendAll([123.45, 234.56, 345.67])
    top[1].AppendAll([234.56, 345.67, 456.78])
    top[2].AppendAll([345.67, 456.78, 567.89])


    For Each a As Array(Of Double) In top
      print(DoSum(a))

    Next

    Return
    End Sub
    Public Sub CheckTableOps()

    Var t As New clDataTable("MyTable")

    t.AppendDataSerie(New clStringDataSerie("Country"))
    t.AppendDataSerie(New clStringDataSerie("City"))
    t.AppendDataSerie(New clDoubleDataSerie("Sales"))

    t.AppendDataRow("Belgium", "Brussels", 123)
    t.AppendDataRow("France", "Paris", 234)
    t.AppendDataRow("Belgium", "Brussels", 123)
    t.AppendDataRow("Belgium", "Brussels", 123)
    t.AppendDataRow("France", "Paris", 234)
    t.AppendDataRow("Belgium", "Brussels", 123)

    Var z As clDataTable = t.GetDistinct(["Country", "Something", "City"])
    print(z.CountRows())

    Return
    End Sub
    Public Sub CheckGroupBy()
    Var t As New clDataTable("MyTable")

    t.AppendDataSerie(New clStringDataSerie("Country"))
    t.AppendDataSerie(New clStringDataSerie("City"))
    t.AppendDataSerie(New clDoubleDataSerie("Sales"))

    t.AppendDataRow("Belgium", "Brussels", 100)
    t.AppendDataRow("France", "Paris", 200)
    t.AppendDataRow("Belgium", "Brussels", 110)
    t.AppendDataRow("Belgium", "Brussels", 120)
    t.AppendDataRow("France", "Paris", 230)
    t.AppendDataRow("Belgium", "Brussels", 130)

    Var z As clDataTable = t.GetGroupBy(["Country", "Something"], ["sum:Sales", "Minimum:Sales", "Top=Maximum:Sales"])

    z.Dump()

    Return
    End Sub
End Class