Public Class clIndexStore

    Public Property MasterIndex As Dictionary
    ## prmIndexDepth is the number of keys/dimensions expected for one row
    Public Constructor(prmIndexDepth As integer, prmNbrAggregators As integer)

    Self.MasterIndex = New Dictionary
    Self.currentDepth = prmIndexDepth
    Self.NbrAccu = prmNbrAggregators

    Return
    End Constructor
    Public Function GetRowIndexes(prmKeys() As string) As Integer()
    #
    # get all rows indexes matching the provided key field values
    # 


    Var results() As Integer
    Var Key As String = ""
    Var remKeys() As String
    Var childList As clIndexStore

    If prmKeys.Count > 0 Then
      For i As Integer = 0 To prmKeys.LastIndex
        If i = 0 Then
          Key = prmKeys[i]
        Else
          remKeys.Append(prmKeys[i])
        End If

      Next

    End If

    If Self.currentDepth <= 1 Then

      If Self.MasterIndex.HasKey(Key) Then
        results.AppendAll(Self.MasterIndex.Value(Key))

      End If

    Else
      If Self.MasterIndex.HasKey(Key) Then
        childList = Self.MasterIndex.Value(Key)
        results = childList.GetRowIndexes(remKeys)
      End If

    End If

    Return results
    End Function
    Public Function getAllRowIndexes() As integer()
    #
    # Returns all indexes in the subtree
    #

    Var Results() As Integer
    Var tempList() As Integer
    Var childList As clIndexStore

    If Self.currentDepth <= 1 Then
      For Each k As String In Self.MasterIndex.Keys
        tempList = Self.MasterIndex.Value(k)
        Results.AppendAll(tempList)

      Next

    Else

      For Each k As String In Self.MasterIndex.Keys
        childList = Self.MasterIndex.Value(k)
        tempList = childList.getAllRowIndexes()
        Results.AppendAll(tempList)

      Next

    End If

    Return Results

    End Function
    Public Property currentDepth As integer
    Public Function GetFlattenedIndex() As clIndexOutputRow()
    #
    # returns selected key values and row indexes
    #

    Var prevKeys() As String

    Return GetFlattenedIndex_Internal(prevKeys)


    End Function
    Protected Function GetFlattenedIndex_Internal(prmPreviousKeys() As string) As clIndexOutputRow()
    #
    # This method processes the current level
    # prmPreviousKeys is used to populate the keys in the clIndexRow 
    #
    Var results() As clIndexOutputRow

    If Self.currentDepth <= 1 Then
      # The object stored in the dictionary is an clIndexStoreLeaf 

      For Each k As String In Self.MasterIndex.Keys
        Var leaf As clIndexStoreLeaf = Self.MasterIndex.Value(k)

        Var r As New clIndexOutputRow
        r.AppendKeys(prmPreviousKeys)
        r.AppendKey(k)
        r.AppendIndexes(leaf.RowIndexes)

        # add accumulators...
        For Each v As Array(Of Double) In leaf.Accumulators
          r.AppendAccumulator(v)
        Next

        results.Append(r)

      Next


      Return results

    Else
      # The object stored in the dictionary is a pointer to the next level

      For Each k As String In Self.MasterIndex.Keys
        Var currentKeys() As String
        Var tempRes() As clIndexOutputRow
        Var Nextlevel As clIndexStore = clIndexStore(Self.MasterIndex.Value(k))

        currentKeys.AppendAll(prmPreviousKeys)
        currentKeys.Append(k)

        tempRes = Nextlevel.GetFlattenedIndex_Internal(currentKeys)

        results.AppendAll(tempRes)

      Next

    End If

    Return results


    End Function
    Protected Function InsertAsNodeEntry(prmCurrentKey As string) As clIndexStore

    Var Key As String = prmCurrentKey

    Var childList As clIndexStore

    If Self.MasterIndex.HasKey(Key) Then
      childList = Self.MasterIndex.Value(Key)

    Else
      childList = New clIndexStore(currentDepth - 1, Self.NbrAccu)
      Self.MasterIndex.Value(Key) = childList

    End If

    Return childList

    End Function
    Public Function GetAllRowIndexesStartingWith(prmStartKeys() As string) As Integer()
    #
    # get all rows indexes matching the provided key field values
    # get all indexes when the


    Var results() As Integer
    Var Key As String = ""
    Var remKeys() As String
    Var childList As clIndexStore

    If prmStartKeys.Count > 0 Then

      # prepare keys

      For i As Integer = 0 To prmStartKeys.LastIndex
        If i = 0 Then
          Key = prmStartKeys[i]
        Else
          remKeys.Append(prmStartKeys[i])
        End If

      Next

    Else
      # Collect all row indexes

      If currentDepth <= 1 Then

        For Each k As String In MasterIndex.Keys
          Var tempRes() As Integer = Self.MasterIndex.Value(k)
          results.AppendAll(tempRes)
        Next

      Else
        # here remKeys is empty
        For Each k As String In MasterIndex.Keys
          childList = Self.MasterIndex.Value(k)
          Var tempRes() As Integer = childList.GetAllRowIndexesStartingWith(remKeys)

          results.AppendAll(tempRes)

        Next


      End If
      Return results

    End If

    If Self.currentDepth <= 1 Then

      If Self.MasterIndex.HasKey(Key) Then
        Var tempRes() As Integer
        tempRes = Self.MasterIndex.Value(Key)
        results.AppendAll(tempRes)

      End If

    Else
      If Self.MasterIndex.HasKey(Key) Then
        childList = Self.MasterIndex.Value(Key)
        results = childList.GetAllRowIndexesStartingWith(remKeys)
      End If

    End If

    Return results
    End Function
  Public Const cstWngCannotInsertKey As String = "cannot insert key(s) ending with %0, extra elements ignored."
    Public Sub AddIndexEntry(prmKeys As array(of string), prmRowIndex As integer, prmValuesToAccumulate() As double)

    If currentDepth = 1 Then # we are inserting in the row indexes
      If prmKeys.Count > 1 Then # this is wrong
        mdHelpers.DataLibLogs().WriteWarning( _
          currentMethodName() _
          , cstWngCannotInsertKey _
          , prmKeys.Join(" ") _
          )

        InsertAsRowIndex(prmKeys[0], prmRowIndex, prmValuesToAccumulate)

        Return

      End If

      If prmKeys.Count = 0 Then
        InsertAsRowIndex("", prmRowIndex, prmValuesToAccumulate)

      Else
        InsertAsRowIndex(prmKeys[0], prmRowIndex, prmValuesToAccumulate)

      End If

      Return

    End If

    Var workKey As String
    Var remKeys() As String

    Var childList As clIndexStore

    If prmKeys.Count = 0 Then # no more keys for insertion
      workKey = ""


    Else
      For i As Integer = 0 To prmkeys.LastIndex
        If i = 0 Then
          workKey = prmKeys[i]

        Else
          remKeys.Append(prmkeys[i])
        End If
      Next

    End If

    childList = InsertAsNodeEntry(workKey)

    childList.AddIndexEntry(remKeys, prmRowIndex, prmValuesToAccumulate)

    Return
    End Sub
    Protected Sub InsertAsRowIndex(prmKey As string, prmRowIndex As integer, prmValuesToAccumulate() As double)
    Var LeafNode As clIndexStoreLeaf

    If Self.MasterIndex.HasKey(prmKey) Then
      LeafNode = Self.MasterIndex.Value(prmKey)

    Else
      LeafNode = New clIndexStoreLeaf(prmValuesToAccumulate.Count)

    End If

    LeafNode.Append(prmRowIndex, prmValuesToAccumulate)

    Self.MasterIndex.Value(prmKey) = LeafNode

    Return
    End Sub
    Public Sub AddIndexEntry(prmKeys As array(of string), prmRowIndex As integer)
    Self.AddIndexEntry(prmKeys, prmRowIndex, [])

    End Sub
    Public Property NbrAccu As integer
End Class