Public Class clStringDataSerie Inherits clAbstractDataSerie

    Public Constructor(prmSerieName As string)

    Super.Constructor(prmSerieName)

    Self.FieldDefinition.SetDefaultValue("")
    Self.FieldDefinition.SetDataType(clDataField.cstTypeString)

    Return

    End Constructor
    Public Property DataStore() As String
 

    Public Sub AppendItem(prmValue As String)

    Self.DataStore.Append(prmValue)

    Return

    End Sub
    Public Override Function Count() As integer

    Return Datastore.Count
    End Function
    Public Sub SetDefaultValue(prmDefaultValue As string)

    Self.FieldDefinition.DefaultValue = prmDefaultValue

    Return

    End Sub
    Public Sub ClearDataStore()

    Self.DataStore.Clear()

    return
    End Sub
    Public Function Element(prmElementIndex As integer) As Object

    Return Self.DataStore[prmElementIndex]
    End Function
    Public Sub Element(prmElementIndex As integer, Assigns prmValue As object)

    Self.DataStore[prmElementIndex] = string(prmValue)
    End Sub
    Public Sub AppendItem(prmValue As object)

    Self.DataStore.Append(String(prmValue))

    Return

    End Sub
    Public Function LastIndex() As integer

    If DataStore.Count = 0 Then Return -1

    Return DataStore.LastIndex
    End Function
End Class