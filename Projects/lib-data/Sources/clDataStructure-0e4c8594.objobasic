Public Class clDataStructure

    Private Property FieldsDefinition() As clDataField
    Constructor()

    Return

    End Constructor
    Public Function AppendFieldDefinition(prmFieldDefinition As clDataField) As Boolean

    If Self.GetFieldDefinition(prmFieldDefinition.Name()) = Nothing Then

      Self.FieldsDefinition.Append(prmFieldDefinition)

      Return True

    Else
      mdHelpers.DataLibLogs().WriteError(CurrentMethodName(), cstErrFieldAlreadyExists, prmFieldDefinition.Name())

      Return False

    End If


    End Function
    Public Constructor(prmSourceStructure As clDataStructure)

    Self.FieldsDefinition.Clear()

    For i As Integer = 0 To prmSourceStructure.LastIndex()
      Self.AppendFieldDefinition(new clDataField(prmSourceStructure.GetFieldDefinition(i)))

    Next

    Return

    End Constructor
    Public Function Count() As integer

    Return Self.FieldsDefinition.Count

    End Function
    Public Function LastIndex() As integer

    Return Self.FieldsDefinition.LastIndex

    End Function
    Public Function GetFieldDefinition(prmFieldIndex As integer) As clDataField

    Try
      Return Self.FieldsDefinition[prmFieldIndex]

    Catch dummy As RuntimeException

      mdHelpers.DataLibLogs().WriteWarning(CurrentMethodName() _
        , cstWngFieldIndexOutOfBound _
        , prmFieldIndex.ToString() _
        , FieldsDefinition.LastIndex.ToString() _
        , dummy.Message _
        )

      Return Nothing

    End Try

    End Function
    ## Return the field definition object of the field matching the name passed as parameter
    Public Function GetFieldDefinition(prmFieldName As String) As clDataField

    If FieldsDefinition.Count > 0 Then

      For i As Integer = 0 To FieldsDefinition.LastIndex
        If Self.FieldsDefinition[i].Name() = prmFieldName Then Return Self.FieldsDefinition[i]

      Next

    End If


    mdHelpers.DataLibLogs().WriteWarning(CurrentMethodName() _
      , cstWngCannotFindFieldDefinition _
      , prmFieldName _
      )

    Return Nothing

    End Function
  Public Const cstErrFieldAlreadyExists As string = "Field %0 already exists in data structure definition"
  Public Const cstWngFieldIndexOutOfBound As string = "Field index out of bound, value %0, limit %1"
  Public Const cstWngCannotFindFieldDefinition As String = "Cannot find definition of field [%0]"
    Public Function InsertFieldDefinition(prmIndex As integer, prmFieldDefinition As clDataField) As Boolean

    If Self.GetFieldDefinition(prmFieldDefinition.Name()) = Nothing Then

      Self.FieldsDefinition.Insert(prmIndex, prmFieldDefinition)

      Return True

    Else
      mdHelpers.DataLibLogs().WriteError(CurrentMethodName(), cstErrFieldAlreadyExists, prmFieldDefinition.Name())

      Return False

    End If


    End Function
End Class