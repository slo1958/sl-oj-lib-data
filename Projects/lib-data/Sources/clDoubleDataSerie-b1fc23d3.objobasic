Public Class clDoubleDataSerie Inherits clAbstractDataSerie

    Public Constructor(prmSerieName As string)

    Super.Constructor(prmSerieName)

    Self.SetupFieldDefinition(0.0)

    Self.ClearDataStore()

    Return

    End Constructor
    Public Sub AppendItem(prmValue As object)

    Self.DataStore.AppendItem(Double(prmValue))

    Return

    End Sub
    Public Property DataStore As clGenericDataStore(of Double)
    Public Sub SetDefaultValue(prmDefaultValue As Double)

    Self.DataStore.SetDefaultValue(prmDefaultValue)
    Self.FieldDefinition.SetDefaultValue(prmDefaultValue)

    Return

    End Sub
    Public Override Sub AppendDefaultItem()

    Self.DataStore.AppendDefaultItem()

    Return
    End Sub
    Public Constructor(prmSourceDataSerie As clDoubleDataSerie)

    Super.Constructor("Cloned from " + prmSourceDataSerie.Name())

    Self.SetupFieldDefinition(prmSourceDataSerie.FieldDefinition.DefaultValue())

    Self.ClearDataStore()

    Var items() As Double

    items = prmSourceDataSerie.DataStore.Items()

    Self.DataStore.AppendItems(items)

    Return
    End Constructor
    Public Function Element(prmElementIndex As integer) As object

    Return Self.DataStore.GetItem(prmElementIndex)
    End Function
    Public Sub Element(prmElementIndex As integer, Assigns prmValue As object)

    Self.DataStore.SetItem(prmElementIndex) = double(prmValue)


    End Sub
    Public Function Count() As integer

    return self.DataStore.Count()
    End Function
    Public Function LastIndex() As integer

    return self.DataStore.LastIndex()
    End Function
    ## Creates an empty datastore and assign default value
    Public Sub ClearDataStore()

    Self.DataStore = New clGenericDataStore(Of Double)

    Self.DataStore.SetDefaultValue(Double(Self.FieldDefinition.DefaultValue()))

    Return
    End Sub
    Protected Sub SetupFieldDefinition(prmDefaultValue As object)

    Self.FieldDefinition.SetDefaultValue(prmDefaultValue)

    Self.FieldDefinition.SetDataType(clDataField.cstTypeNumber)

    Return

    End Sub
    Public Shared Function operator_divide(s1 As clDoubleDataSerie, s2 As clDoubleDataSerie) As clDoubleDataSerie

    Var results As New clDoubleDataSerie(s1.Name() + "/" + s2.Name())

    Var limit1 As Integer = s1.LastIndex()
    Var limit2 As Integer = s2.LastIndex()

    For i As Integer = 0 To mdhelpers.Maximum(limit1, limit2)
      If i <= limit1 And i <= limit2 Then
        results.AppendItem(mdHelpers.NiceDivide(Double(s1.Element(i)), Double(s2.Element(i))))
      Else
        results.AppendDefaultItem()

      End If

    Next

    Return results




    End Function
    Public Shared Function operator_divide(s1 As clDoubleDataSerie, s2 As clIntegerDataSerie) As clDoubleDataSerie

    Var results As New clDoubleDataSerie(s1.Name() + "/" + s2.Name())

    Var limit1 As Integer = s1.LastIndex()
    Var limit2 As Integer = s2.LastIndex()

    For i As Integer = 0 To mdhelpers.Maximum(limit1, limit2)
      If i <= limit1 And i <= limit2 Then
        results.AppendItem(mdHelpers.NiceDivide(Double(s1.Element(i)), integer(s2.Element(i))))
      Else
        results.AppendDefaultItem()

      End If

    Next

    Return results




    End Function
    Public Shared Function operator_multiply(s1 As clDoubleDataSerie, s2 As clDoubleDataSerie) As clDoubleDataSerie

    Var results As New clDoubleDataSerie(s1.Name() + "*" + s2.Name())

    Var limit1 As Integer = s1.LastIndex()
    Var limit2 As Integer = s2.LastIndex()

    For i As Integer = 0 To mdhelpers.Maximum(limit1, limit2)
      If i <= limit1 And i <= limit2 Then
        results.AppendItem(Double(s1.Element(i)) * Double(s2.Element(i)))
      Else
        results.AppendDefaultItem()

      End If

    Next

    Return results




    End Function
    Public Shared Function operator_multiply(s1 As clDoubleDataSerie, s2 As clIntegerDataSerie) As clDoubleDataSerie

    Var results As New clDoubleDataSerie(s1.Name() + "*" + s2.Name())

    Var limit1 As Integer = s1.LastIndex()
    Var limit2 As Integer = s2.LastIndex()

    For i As Integer = 0 To mdhelpers.Maximum(limit1, limit2)
      If i <= limit1 And i <= limit2 Then
        results.AppendItem(Double(s1.Element(i)) * Integer(s2.Element(i)))
      Else
        results.AppendDefaultItem()

      End If

    Next

    Return results




    End Function
    Public Shared Function operator_divide(s1 As clDoubleDataSerie, s2 As double) As clDoubleDataSerie

    Var results As New clDoubleDataSerie(s1.Name() + "/" + s2.ToString())

    Var limit1 As Integer = s1.LastIndex()

    For i As Integer = 0 To limit1
      If i <= limit1 Then
        results.AppendItem(mdHelpers.NiceDivide(Double(s1.Element(i)), s2))
      Else
        results.AppendDefaultItem()

      End If

    Next

    Return results




    End Function
    Public Shared Function operator_multiply(s1 As clDoubleDataSerie, s2 As double) As clDoubleDataSerie

    Var results As New clDoubleDataSerie(s1.Name() + "*" + s2.ToString())

    Var limit1 As Integer = s1.LastIndex()

    For i As Integer = 0 To limit1
      If i <= limit1 Then
        results.AppendItem(Double(s1.Element(i)) * s2)
      Else
        results.AppendDefaultItem()

      End If

    Next

    Return results




    End Function
    Public Shared Function operator_add(s1 As clDoubleDataSerie, s2 As clDoubleDataSerie) As clDoubleDataSerie

    Var results As New clDoubleDataSerie(s1.Name() + "+" + s2.Name())

    Var limit1 As Integer = s1.LastIndex()
    Var limit2 As Integer = s2.LastIndex()

    For i As Integer = 0 To mdhelpers.Maximum(limit1, limit2)
      If i <= limit1 And i <= limit2 Then
        results.AppendItem(Double(s1.Element(i)) + Double(s2.Element(i)))
      Else
        results.AppendDefaultItem()

      End If

    Next

    Return results




    End Function
    Public Shared Function operator_add(s1 As clDoubleDataSerie, s2 As clIntegerDataSerie) As clDoubleDataSerie

    Var results As New clDoubleDataSerie(s1.Name() + "+" + s2.Name())

    Var limit1 As Integer = s1.LastIndex()
    Var limit2 As Integer = s2.LastIndex()

    For i As Integer = 0 To mdhelpers.Maximum(limit1, limit2)
      If i <= limit1 And i <= limit2 Then
        results.AppendItem(Double(s1.Element(i)) + Integer(s2.Element(i)))
      Else
        results.AppendDefaultItem()

      End If

    Next

    Return results




    End Function
    Public Shared Function operator_add(s1 As clDoubleDataSerie, s2 As double) As clDoubleDataSerie

    Var results As New clDoubleDataSerie(s1.Name() + "+" + s2.ToString())

    Var limit1 As Integer = s1.LastIndex()

    For i As Integer = 0 To limit1
      If i <= limit1 Then
        results.AppendItem(Double(s1.Element(i)) + s2)
      Else
        results.AppendDefaultItem()

      End If

    Next

    Return results




    End Function
    Public Shared Function Operator_Subtract(s1 As clDoubleDataSerie, s2 As clDoubleDataSerie) As clDoubleDataSerie

    Var results As New clDoubleDataSerie(s1.Name() + "-" + s2.Name())

    Var limit1 As Integer = s1.LastIndex()
    Var limit2 As Integer = s2.LastIndex()

    For i As Integer = 0 To mdhelpers.Maximum(limit1, limit2)
      If i <= limit1 And i <= limit2 Then
        results.AppendItem(Double(s1.Element(i)) - Double(s2.Element(i)))
      Else
        results.AppendDefaultItem()

      End If

    Next

    Return results




    End Function
    Public Shared Function operator_subtract(s1 As clDoubleDataSerie, s2 As clIntegerDataSerie) As clDoubleDataSerie

    Var results As New clDoubleDataSerie(s1.Name() + "-" + s2.Name())

    Var limit1 As Integer = s1.LastIndex()
    Var limit2 As Integer = s2.LastIndex()

    For i As Integer = 0 To mdhelpers.Maximum(limit1, limit2)
      If i <= limit1 And i <= limit2 Then
        results.AppendItem(Double(s1.Element(i)) - Integer(s2.Element(i)))
      Else
        results.AppendDefaultItem()

      End If

    Next

    Return results




    End Function
    Public Shared Function operator_subtract(s1 As clDoubleDataSerie, s2 As double) As clDoubleDataSerie

    Var results As New clDoubleDataSerie(s1.Name() + "-" + s2.ToString())

    Var limit1 As Integer = s1.LastIndex()

    For i As Integer = 0 To limit1
      If i <= limit1 Then
        results.AppendItem(Double(s1.Element(i)) - s2)
      Else
        results.AppendDefaultItem()

      End If

    Next

    Return results




    End Function

    Public Function Elements() As double()

    Return Self.DataStore.Items()

    End Function
End Class