Public Module DoubleExtensions

  Public Function Minimum(Extends s As clDoubleDataSerie) As double

  Return mdAggregate.CalcMinimum(s.Elements())
  End Function
  Public Function Maximum(Extends s As clDoubleDataSerie) As double

  Return mdAggregate.CalcMaximum(s.Elements())
  End Function
  Public Function MinimumNonZero(Extends s As clDoubleDataSerie) As double

  Return mdAggregate.CalcMinimumNonZero(s.Elements())
  End Function
  Public Function Average(Extends s As clDoubleDataSerie) As double

  Return mdAggregate.CalcAverage(s.Elements())

  End Function
  Public Function AverageNonZero(Extends s As clDoubleDataSerie) As double
  Return mdAggregate.CalcAverageNonZero(s.Elements())
  End Function
  Public Function CountNonZero(Extends s As clDoubleDataSerie) As integer

  Return mdAggregate.CalcCountNonZero(s.Elements())

  End Function
  Public Function MaximumNonZero(Extends s As clDoubleDataSerie) As double

  Return mdAggregate.CalcMaximumNonZero(s.Elements())
  End Function
End Module