Public Class clDataTable

    Public Property DataSeries() As clAbstractDataSerie
    ## Add an entry to the metadata associated with the dataSerie
    Public Sub AppendMetaData(prmWho As string, prmWhat As string)

    If Self.MetaData <> Nothing Then
      Self.MetaData.Add(prmWho, prmWhat)

    End If

    Return

    End Sub
    Public Constructor(prmTableName As string)

    Self.MetaData = New clMetaData
    Self.Name = prmTableName
    Self.DisplayName = prmTableName

    Self.IndexDataSerie = New clAutoIncrementDataSerie(cstIndexSerieName)

    Self.DeletedFlagDataSerie = New clBooleanDataSerie(cstMaskSerieName)
    Self.DeletedFlagDataSerie.SetDefaultValue(True)


    Self.cachedStructure = Nothing

    Self.FilterDataSerie = Nothing

    Return


    End Constructor
    Public Property Name As String
    Public Property MetaData As clMetaData
    ## Add an entry to the metadata associated with the dataSerie
    Public Function AppendDataSerie(ParamArray prmDataSeries As clAbstractDataSerie) As Boolean

    Var errCount As Integer = 0

    For Each prmDataSerie As clAbstractDataSerie In prmDataSeries

      Var serieName As String = prmDataSerie.Name()

      If Not ValidSerieName(serieName) Then

        mdHelpers.DataLibLogs().WriteError(CurrentMethodName() _
          , cstErrInvalidFieldName _
          , serieName _
          )

        errCount += 1

      Else
        Self.AppendDataSerie_Internal(prmDataSerie)

      End If


    Next

    Return errCount = 0

    End Function
    Public Property DisplayName As String
    ## Get the number of items in the datatable. It is the number of items in the largest data serie
    ##
    Public Function CountRows() As integer

    Var results As Integer

    For Each serie As clAbstractDataSerie In Self.DataSeries
      If serie.Count() > results Then results = serie.Count()

    Next

    Return results


    End Function
    Public Function ResizeTo(prmTargetSize As integer) As integer

    Var maxSize As Integer = Self.CountRows()

    If maxSize > prmTargetSize Then Return maxSize

    For Each serie As clAbstractDataSerie In DataSeries
      serie.ResizeTo(prmTargetSize)

    Next

    Self.IndexDataSerie.ResizeTo(prmTargetSize)
    Self.DeletedFlagDataSerie.ResizeTo(prmTargetSize)

    Return prmTargetSize




    End Function
    Public Function FixSize() As integer

    Var maxSize As Integer = Self.CountRows()

    For Each serie As clAbstractDataSerie In DataSeries
      serie.ResizeTo(maxSize)
    Next

    Self.IndexDataSerie.ResizeTo(maxSize)
    Self.DeletedFlagDataSerie.ResizeTo(maxSize)

    Return maxSize




    End Function
    Public Property IndexDataSerie As clAutoIncrementDataSerie
    Public Property DeletedFlagDataSerie As clBooleanDataSerie
    Public Sub SetDisplayName(prmDisplayName As string)

    Self.DisplayName = prmDisplayName
    Self.MetaData.Add(CurrentMethodName(), mdHelpers.ReplaceItems("Update display name of %0 to %1", Self.Name, prmDisplayName))
    Return


    End Sub
  Public Const cstIndexSerieName As string = "SYS$Index"
  Public Const cstMaskSerieName As string = "SYS$RowMask"
    Public Function GetDataSerie(prmSerieIndex As integer) As clAbstractDataSerie

    If prmSerieIndex = cstIndexSerieIndex Then Return Self.IndexDataSerie
    If prmSerieIndex = cstMaskSerieIndex Then Return Self.DeletedFlagDataSerie

    Return DataSeries[prmSerieIndex]
    End Function
    Public Function DataRow(prmRowIndex As integer, withIndex As Boolean) As clDataRow

    # Create a datarow, keep datastructure unlocked
    Var results As New clDataRow(Self.TableStructure(), True)

    Var fieldIndexOffset As Integer = 0

    If WithIndex Then
      results.InsertFieldDefinition(0, Self.IndexDataSerie.GetFieldDefinition())
      fieldIndexOffset = 1
      results.SetField(0, Self.IndexDataSerie.Element(prmRowIndex))

    End If

    results.LockStructure()

    For i As Integer = 0 To DataSeries.LastIndex
      Var fieldValue As Object = Self.DataSeries[i].Element(prmRowIndex)
      results.SetField(fieldIndexOffset + i, fieldValue)

    Next

    Return results


    End Function
    Public Function TableStructure() As clDataStructure

    If Self.cachedStructure = Nothing Then

      Var results As new clDataStructure

      For Each serie As clAbstractDataSerie In DataSeries
        results.AppendFieldDefinition(serie.Definition())

      Next

      Self.cachedStructure = results
      Return results

    Else
      Return Self.cachedStructure

    End If


    End Function
    Private Property cachedStructure As clDataStructure
    ## Add fields from the data row to the table using field names
    Public Sub AppendDataRow(prmRow As clDataRow)


    For i As Integer = 0 To Self.DataSeries.LastIndex
      Var fieldname As String = Self.DataSeries[i].Name()
      Var srcFieldIndex As Integer = prmRow.FieldIndex(fieldname)

      If srcFieldIndex >= 0 Then
        Self.DataSeries[i].AppendItem(prmRow.GetField(srcFieldIndex))

      Else
        Self.DataSeries[i].AppendDefaultItem()

      End If

    Next

    # Just in case...
    Self.FixSize()

    Return

    End Sub
    Public Function GetDataSerie(prmSerieName As string) As clAbstractDataSerie

    Var tempIndex As Integer = Self.SerieIndex(prmSerieName)

    Return DataSeries[tempIndex]

    End Function
    ## Return the index of the dataserie
    Public Function SerieIndex(prmFieldName As string) As integer

    If Self.DataSeries.Count = 0 Then Return -1

    For i As Integer = 0 To Self.DataSeries.LastIndex
      Var tempName As String = Self.DataSeries[i].Name()

      If tempName = prmFieldName Then Return i

    Next

    Return -1

    End Function
    Public Shared Function ValidSerieName(prmSerieName As string) As Boolean

    If prmSerieName.Trim().Length = 0 Then Return False

    If prmSerieName.Trim() = cstIndexSerieName Then Return False
    If prmSerieName.Trim() = cstMaskSerieName Then Return False

    Return True

    End Function
    ## Add an entry to the metadata associated with the dataSerie
    Private Sub AppendDataSerie_Internal(prmDataSerie As clAbstractDataSerie)

    Var tempName As String = prmDataSerie.Name()

    If Self.SerieIndex(tempName) >= 0 Then

      mdHelpers.DataLibLogs().WriteError(CurrentMethodName() _
        , cstErrFieldAlreadyDefined _
        , tempName _
        , Self.Name _
        )

      Return
    End If

    # Reset cached structure
    Self.cachedStructure = Nothing


    Self.DataSeries.Append(prmDataSerie)

    # Self.AppendMetaData(CurrentMethodName(), prmWhat)

    Return

    End Sub
  Public Const cstErrInvalidFieldName As string = "Invalid field name [%0]"
  Public Const cstErrFieldAlreadyDefined As string = "Field [%0] already defined in [%1]"
    ## Add values to the table using field index
    Public Sub AppendDataRow(ParamArray values() As Object)

    For i As Integer = 0 To Self.DataSeries.LastIndex

      If i <= values.LastIndex Then
        Self.DataSeries[i].AppendItem(values[i])

      Else
        Self.DataSeries[i].AppendDefaultItem()

      End If

    Next

    # Just in case...
    Self.FixSize()

    Return

    End Sub
    Public Function LastRowIndex() As integer
    Return DeletedFlagDataSerie.LastIndex()

    End Function
    Public Sub EnableFilter()
    Self.FilterMode = True

    End Sub
    Public Sub DisableFilter()
    self.FilterMode = false
    End Sub
    Public Property FilterMode As Boolean
    Public Sub EnableFilter(prmFilterData As clBooleanDataSerie)
    Self.FilterMode = True
    Self.FilterDataSerie = prmFilterData
    Return
    End Sub
    Public Property FilterDataSerie As clBooleanDataSerie
    Public Function LastDataSerieIndex() As integer

    Return Self.DataSeries.LastIndex

    End Function
    ## Get the number of items in the datatable. It is the number of items in the largest data serie
    ##
    Public Function CountDataSeries() As integer

    Return Self.DataSeries.Count



    End Function
  Public Const cstIndexSerieIndex As integer = -1
  Public Const cstMaskSerieIndex As Integer = -2
End Class