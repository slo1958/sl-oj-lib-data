Class Window1 Inherits Window

    Sub Button1_Pressed()

    Var tbl As New clDataTable("MyTable")

    Var s1 As New clStringDataSerie("Country")
    Var s2 As New clDoubleDataSerie("Sales")
    Var s3 As New clIntegerDataSerie("Volume")
    Var s4 As New clBooleanDataSerie("Actif")

    _ = tbl.AppendDataSerie(s1, s2, s3, s4)

    tbl.AppendDataRow("Belgium", 12000, 1100, True)
    tbl.AppendDataRow("France", 14000, 1200, False)
    tbl.AppendDataRow("Italy", 12500, 1700)
    tbl.AppendDataRow("France", 14000, 1200)
    tbl.AppendDataRow("Italy", 12500, 1700)

    Listbox1.RemoveAllRows()



    # we include the index in the output, hence + 1
    Listbox1.ColumnCount = tbl.CountDataSeries() + 1
    listbox1.SetHeaderText(0, "Index")

    Var colIndex As Integer = 0

    For Each ds As clAbstractDataSerie In New clByDataSerie(tbl)

      listbox1.SetHeaderText(colIndex + 1, ds.Name())
      colIndex += 1

    Next



    For Each dr As clDataRow In New clByRowWithIndex(tbl)
      Var idxRow As Integer = Listbox1.AddRow()

      For idxCol As Integer = 0 To dr.LastIndex()
        listbox1.SetCellText(idxRow, idxCol, dr.GetField(idxCol).ToString())

      Next

      # listbox1.SetCellText(idxRow, 0, dr.GetField(0).ToString())
      # listbox1.SetCellText(idxRow, 1, dr.GetField(1).ToString())
      # listbox1.SetCellText(idxRow, 2, dr.GetField(2).ToString())
      # listbox1.SetCellText(idxRow, 3, dr.GetField(3).ToString())


    Next

    Var myserie As clAbstractDataSerie = tbl.GetDataSerie(clDataTable.cstIndexSerieIndex)
    Label1.Text = myserie.LastIndex().ToString()


    Return
    End Sub
    Sub Button2_Opening()
    End Sub
    Sub Button2_Pressed()
    Var ds0 As New clDoubleDataSerie("test")

    ds0.AppendItem(100.0)
    ds0.AppendItem(200.0)
    ds0.AppendItem(300.0)

    Var ts As New clLowBoundDoubleTransformation(ds0, False)

    ts.SetBoundary(150)

    ts.TransformInPlace()

    Return
    End Sub
End Class