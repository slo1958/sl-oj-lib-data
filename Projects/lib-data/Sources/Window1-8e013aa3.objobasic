Class Window1 Inherits Window

    Sub Button1_Pressed()

    Var tbl As New clDataTable("MyTable")

    Var s0 As New clStringDataSerie("Country")
    Var s1 As New clStringDataSerie("Product")
    Var s2 As New clDoubleDataSerie("Sales")
    Var s3 As New clIntegerDataSerie("Volume")
    Var s4 As New clBooleanDataSerie("Actif")

    _ = tbl.AppendDataSerie(s0, s1, s2, s3, s4)

    tbl.AppendDataRow("Belgium", "Product1", 12000, 1100, True)
    tbl.AppendDataRow("France", "Product2", 14000, 1200, False)
    tbl.AppendDataRow("Italy", "Product2", 12500, 1700)
    tbl.AppendDataRow("France", "Product1", 14000, 1200)
    tbl.AppendDataRow("Italy", "Product1", 12500, 1700)


    # Adding a column with price, which is sales divided by volume
    Var s5 As clDoubleDataSerie

    For i As Integer = 0 To s1.LastIndex()
      s5 = s2 / s3

    Next

    tbl.AppendDataSerie(s5)

    #calculate VAT on sales

    Var s6 As clDoubleDataSerie
    s6 = s2 * 0.21
    s6.Rename("VAT")
    tbl.AppendDataSerie(s6)

    #
    #
    #

    #
    # Apply filter ?
    #

    If CheckBox1.Checked Then

      Var ts As New clLowBoundDoubleTransformation(s5, True)
      ts.SetBoundary(10.00)

      # The lowbound transformer identifies rows where the value is below boundary
      # We run the filter, only to get the bitmap of changes
      # 
      ts.TransformNoUpdate()

      tbl.AppendUserMaskDataSeries(ts.ChangeMask())


    End If



    #
    # Ready to display
    #

    Listbox1.RemoveAllRows()



    # we include the index in the output, hence + 1
    Listbox1.ColumnCount = tbl.CountDataSeries() + 1
    listbox1.SetHeaderText(0, "Index")

    Var colIndex As Integer = 0

    For Each ds As clAbstractDataSerie In New clByDataSerie(tbl)

      listbox1.SetHeaderText(colIndex + 1, ds.Name())
      colIndex += 1

    Next



    For Each dr As clDataRow In New clByRowWithIndex(tbl)
      Var idxRow As Integer = Listbox1.AddRow()

      For idxCol As Integer = 0 To dr.LastIndex()
        listbox1.SetCellText(idxRow, idxCol, dr.GetField(idxCol).ToString())

      Next

      # listbox1.SetCellText(idxRow, 0, dr.GetField(0).ToString())
      # listbox1.SetCellText(idxRow, 1, dr.GetField(1).ToString())
      # listbox1.SetCellText(idxRow, 2, dr.GetField(2).ToString())
      # listbox1.SetCellText(idxRow, 3, dr.GetField(3).ToString())


    Next

    Var myserie As clAbstractDataSerie = tbl.GetDataSerie(clDataTable.cstIndexSerieIndex)
    Label1.Text = myserie.LastIndex().ToString()


    Return
    End Sub
End Class