Public Class clStringDataSerie Inherits clAbstractDataSerie

    Public Constructor(prmSerieName As string)

    Super.Constructor(prmSerieName)

    Self.SetupFieldDefinition(0.0)

    Self.ClearDataStore()

    Return

    End Constructor
    Public Sub AppendItem(prmValue As object)

    Self.DataStore.AppendItem(String(prmValue))

    Return

    End Sub
    Public Property DataStore As clGenericDataStore(of String)
    Public Sub SetDefaultValue(prmDefaultValue As String)

    Self.DataStore.SetDefaultValue(prmDefaultValue)
    Self.FieldDefinition.SetDefaultValue(prmDefaultValue)

    Return

    End Sub
    Public Override Sub AppendDefaultItem()

    Self.DataStore.AppendDefaultItem()

    Return
    End Sub
    Public Constructor(prmSourceDataSerie As clStringDataSerie)

    Super.Constructor("Cloned from " + prmSourceDataSerie.Name())

    Self.SetupFieldDefinition(prmSourceDataSerie.FieldDefinition.DefaultValue())

    Self.ClearDataStore()

    Var items() As String

    items = prmSourceDataSerie.DataStore.Items()

    Self.DataStore.AppendItems(items)

    Return
    End Constructor
    Public Function Element(prmElementIndex As integer) As object

    Return Self.DataStore.GetItem(prmElementIndex)
    End Function
    Public Sub Element(prmElementIndex As integer, Assigns prmValue As object)

    Self.DataStore.SetItem(prmElementIndex) = String(prmValue)


    End Sub
    Public Function Count() As integer

    return self.DataStore.Count()
    End Function
    Public Function LastIndex() As integer

    return self.DataStore.LastIndex()
    End Function
    ## Creates an empty datastore and assign default value
    Public Sub ClearDataStore()

    Self.DataStore = New clGenericDataStore(Of String)

    Self.DataStore.SetDefaultValue(String(Self.FieldDefinition.DefaultValue()))

    Return
    End Sub
    Protected Sub SetupFieldDefinition(prmDefaultValue As object)

    Self.FieldDefinition.SetDefaultValue(prmDefaultValue)

    Self.FieldDefinition.SetDataType(clDataField.cstTypeString)

    Return

    End Sub
    Public Shared Function operator_add(s1 As clStringDataSerie, s2 As clStringDataSerie) As clStringDataSerie

    Var results As New clStringDataSerie(s1.Name() + "+" + s2.Name())

    Var limit1 As Integer = s1.LastIndex()
    Var limit2 As Integer = s2.LastIndex()

    For i As Integer = 0 To mdhelpers.Maximum(limit1, limit2)
      If i <= limit1 And i <= limit2 Then
        results.AppendItem(String(s1.Element(i)) + String(s2.Element(i)))
      Else
        results.AppendDefaultItem()

      End If

    Next

    Return results




    End Function
    Public Shared Function operator_add(s1 As clStringDataSerie, s2 As String) As clStringDataSerie

    Var results As New clStringDataSerie(s1.Name() + "+" + s2)

    Var limit1 As Integer = s1.LastIndex()


    For i As Integer = 0 To limit1
      If i <= limit1 Then
        results.AppendItem(String(s1.Element(i)) + s2)
      Else
        results.AppendDefaultItem()

      End If

    Next

    Return results




    End Function
    Public Shared Function operator_add(s1 As String, s2 As clStringDataSerie) As clStringDataSerie

    Var results As New clStringDataSerie(s1 + "+" + s2.Name())


    Var limit2 As Integer = s2.LastIndex()

    For i As Integer = 0 To limit2
      If i <= limit2 Then
        results.AppendItem(s1 + String(s2.Element(i)))
      Else
        results.AppendDefaultItem()

      End If

    Next

    Return results




    End Function
End Class