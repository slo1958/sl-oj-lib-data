Public Class clIndexStoreLeaf

    Public Property RowIndexes() As integer
    Public Property Accumulators() As array(of double)
    Public Constructor(prmNbrAccumulators As integer)

    Self.Accumulators.Clear()

    For i As Integer = 0 To prmNbrAccumulators - 1
      Var v() As Double
      Self.Accumulators.Append(v)

    Next
    End Constructor
    Public Sub Append(prmRowIndex As integer, prmValuesToAccumulate() As double)

    If Self.RowIndexes.IndexOf(prmrowIndex) < 0 Then
      Self.RowIndexes.Append(prmrowindex)

      If Self.Accumulators.Count > 0 Then
        For i As Integer = 0 To Self.Accumulators.LastIndex

          If prmValuesToAccumulate.LastIndex >= i Then
            Self.Accumulators[i].Append(prmValuesToAccumulate[i])

          End If

        Next
      End If


    End If

    End Sub
End Class