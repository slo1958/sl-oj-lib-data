Public Class clDataRow

    Public Property FieldsValue() As Object
    ## Creates a datarow object. Note that the pointer to the structure is used as is, the constructor does not clone the content. If Nothing is passed, then the structure can be created on the fly.
    Public Constructor(prmStructure As clDataStructure, Optional prmKeepUnlocked As boolean = false)

    If prmStructure = Nothing Then
      Self.DataStructure = New clDataStructure
      Self.LockedStructure = False

    Else
      Self.DataStructure = prmStructure
      Self.AdjustDataSize(False)
      Self.LockedStructure = not prmKeepUnlocked

    End If


    End Constructor
    Public Sub SetField(prmFieldName As string, prmFieldValue As object)

    Var tmpIndex As Integer = Self.FieldIndex(prmFieldname)

    If tmpIndex < 0 Then

      # If the field does not exist in the structure, and the lock is off, we can add the field

      If Self.LockedStructure Then

        mdHelpers.DataLibLogs().WriteError(CurrentMethodName() _
          , cstErrCannotAddFieldToLocked _
          , prmFieldName _
          )

        Return

      Else
        Var fld As clDataField = clDataField.BuildFieldDefinition(prmFieldValue)

        Self.DataStructure.AppendFieldDefinition(fld)
        Self.FieldsValue.Append(prmFieldValue)


      End If

    Else

      Self.FieldsValue[tmpIndex] = prmFieldValue

    End If


    Return

    End Sub
    Public Property DataStructure As clDataStructure
    Public Function GetField(prmFieldName As string) As object

    Try
      Return Self.FieldsValue[Self.FieldIndex(prmFieldname)]

    Catch dummy As RuntimeException
      Return Nothing

    End Try


    End Function
    Public Sub SetField(prmFieldIndex As integer, prmFieldValue As object)

    Try
      Self.FieldsValue[prmFieldIndex] = prmFieldValue

    Catch dummy As RuntimeException

      mdHelpers.DataLibLogs().WriteError(CurrentMethodName() _
        , cstErrIndexOutOfRange _
        , prmFieldIndex.ToString() _
        )

    End Try

    Return

    End Sub
    Public Function GetField(prmFieldIndex As integer) As object
    Try
      Return Self.FieldsValue[prmFieldIndex]

    Catch dummy as RuntimeException
      Return Nothing

    End Try

    End Function
    ## Return the index of the field
    Public Function FieldIndex(prmFieldName As string) As integer

    For i As Integer = 0 To DataStructure.LastIndex()
      If Self.DataStructure.GetFieldDefinition(i).Name() = prmFieldName Then Return i

    Next

    Return -1

    End Function
    Public Function LastIndex() As integer

    Return Self.FieldsValue.LastIndex

    End Function
    Private Property LockedStructure As Boolean
    Public Function GetFieldName(prmFieldIndex As integer) As string

    Return Self.DataStructure.GetFieldDefinition(prmFieldIndex).Name()

    End Function
    Public Sub LockStructure()

    Self.LockedStructure = True

    Return

    End Sub
  Public Const cstErrCannotAddFieldToLocked As String = "Cannot add field [%0] to a locked clDataRow"
  Public Const cstErrIndexOutOfRange As String = "Index %0 is out of range in %1"
    Sub MyMethod()
    End Sub
    ## Add a new field definition at the end of the set of fields
    Public Sub AppendFieldDefinition(prmFieldDefinition As clDataField)


    If Self.LockedStructure Then

      mdHelpers.DataLibLogs().WriteError(CurrentMethodName() _
        , cstErrCannotAddFieldToLocked _
        , prmFieldDefinition.Name() _
        )

      Return

    End If

    Self.DataStructure.AppendFieldDefinition(prmFieldDefinition)

    Self.AdjustDataSize(True)

    Return

    End Sub
    ## Adjust the size of the data store to match the number of fields in the data structure.
    Protected Sub AdjustDataSize(prmPreserveData As Boolean)

    Self.FieldsValue.Resize(self.DataStructure.Count())

    If prmPreserveData Then Return

    For i As Integer = 0 To Self.FieldsValue.LastIndex
      Self.FieldsValue[i] = Nothing

    Next

    Return

    End Sub
    Public Sub InsertFieldDefinition(prmFieldIndex As integer, prmFieldDefinition As clDataField)


    If Self.LockedStructure Then

      mdHelpers.DataLibLogs().WriteError(CurrentMethodName() _
        , cstErrCannotAddFieldToLocked _
        , prmFieldDefinition.Name() _
        )

      Return

    End If

    Self.DataStructure.InsertFieldDefinition(prmFieldIndex, prmFieldDefinition)

    Self.AdjustDataSize(False)

    Return

    End Sub
End Class