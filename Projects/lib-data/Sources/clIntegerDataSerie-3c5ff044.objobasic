Public Class clIntegerDataSerie Inherits clAbstractDataSerie

    Public Constructor(prmSerieName As string)

    Super.Constructor(prmSerieName)

    Self.SetupFieldDefinition(0)

    Self.FieldDefinition.SetDataType(clDataField.cstTypeBoolean)

    Self.ClearDataStore()


    Return

    End Constructor
    Public Sub AppendItem(prmValue As object)

    Self.DataStore.AppendItem(Integer(prmValue))

    Return

    End Sub
    Public Property DataStore As clGenericDataStore(of integer)
    Public Sub SetDefaultValue(prmDefaultValue As integer)

    Self.DataStore.SetDefaultValue(prmDefaultValue)
    Self.FieldDefinition.SetDefaultValue(prmDefaultValue)

    Return

    End Sub
    Public Override Sub AppendDefaultItem()

    Self.DataStore.AppendDefaultItem()

    Return
    End Sub
    Public Constructor(prmSourceDataSerie As clIntegerDataSerie)

    Super.Constructor("Cloned from " + prmSourceDataSerie.Name())

    Self.SetupFieldDefinition(prmSourceDataSerie.FieldDefinition.DefaultValue())

    Self.ClearDataStore()

    Var items() As integer

    items = prmSourceDataSerie.DataStore.Items()

    Self.DataStore.AppendItems(items)

    Return
    End Constructor
    Public Function Element(prmElementIndex As integer) As object

    Return Self.DataStore.GetItem(prmElementIndex)
    End Function
    Public Sub Element(prmElementIndex As integer, Assigns prmValue As object)

    Self.DataStore.SetItem(prmElementIndex) = Integer(prmValue)


    End Sub
    Public Function Count() As integer

    return self.DataStore.Count()
    End Function
    Public Function LastIndex() As integer

    return self.DataStore.LastIndex()
    End Function
    ## Creates an empty datastore and assign default value
    Public Sub ClearDataStore()

    Self.DataStore = New clGenericDataStore(Of Integer)

    Self.DataStore.SetDefaultValue(Integer(Self.FieldDefinition.DefaultValue()))

    Return
    End Sub
    Protected Sub SetupFieldDefinition(prmDefaultValue As object)

    Self.FieldDefinition.SetDefaultValue(prmDefaultValue)

    Self.FieldDefinition.SetDataType(clDataField.cstTypeInteger)

    Return

    End Sub
End Class