Public Class clRangeDoubleTransformation Inherits clAbstractDoubleTransformation

    Public Sub SetBoundaries(prmLowBoundary As Double, prmHighBoundary As Double)
    Self.LowBoundary = prmLowBoundary
    Self.HighBoundary = prmHighBoundary

    Return

    End Sub
    Protected Property HighBoundary As Double = 0
    Protected Override Function TransformElement(prmElementIndex As integer, prmElementValue As Double) As double

    Var tempLowBoundary As Double = Self.getBoundary(prmElementIndex, Self.LowBoundary, Self.LowBoundarySerie)
    Var tempHighBoundary As Double = Self.getBoundary(prmElementIndex, Self.HighBoundary, Self.HighBoundarySerie)

    If prmElementValue > tempHighBoundary Then Return tempHighBoundary
    If prmElementValue < tempLowBoundary Then Return tempLowBoundary

    Return prmElementValue




    End Function
    Public Constructor(prmSourceDataSerie As clDoubleDataSerie, prmBuildChangeMask As Boolean)

    Super.Constructor(prmSourceDataSerie, prmBuildChangeMask)

    Self.Name = "Range"

    Self.LowBoundary = Double.MinValue

    Self.HighBoundary = Double.MaxValue

    Return


    End Constructor
    Protected Property LowBoundary As Double = 0
    Protected Property LowBoundarySerie As clDoubleDataSerie = Nothing
    Protected Property HighBoundarySerie As clDoubleDataSerie = Nothing
    Public Sub SetBoundaries(prmLowBoundary As clDoubleDataSerie, prmHighBoundary As clDoubleDataSerie)
    Self.LowBoundarySerie = prmLowBoundary
    Self.HighBoundarySerie = prmHighBoundary

    Return

    End Sub
    Private Function getBoundary(prmElementIndex As integer, prmFixed As double, prmSerie As clDoubleDataSerie) As double


    If prmSerie = Nothing Then
      Return prmFixed

    ElseIf prmElementIndex > prmSerie.LastIndex() Then
      Return prmFixed

    Else
      Return Double(prmSerie.Element(prmElementIndex))

    End If
    End Function
End Class