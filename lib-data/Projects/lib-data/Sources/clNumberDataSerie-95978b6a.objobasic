Public Class clNumberDataSerie Inherits clAbstractDataSerie

    Public Property DataStore() As Double
    Public Override Function Count() As integer

    Return Datastore.Count
    End Function
    Public Property DefaultValue As Double
    Public Constructor(prmSerieName As string)

    Super.Constructor(prmSerieName)
    Self.DefaultValue = 0

    Self.SerieDataType = clDataField.cstTypeNumber

    Return

    End Constructor
    ## Add one entry set to default value
    Public Sub AppendDefaultItem()

    Self.DataStore.Append(Self.DefaultValue)

    Return

    End Sub
    Public Sub SetDefaultValue(prmDefaultValue As Double)

    Self.DefaultValue = prmDefaultValue

    Return

    End Sub
    Public Sub AppendItem(prmValue As Double)

    Self.DataStore.Append(prmValue)

    Return

    End Sub
    Public Sub ClearDataStore()

    Self.DataStore.Clear()

    return
    End Sub
    Public Function GetType() As string

    Return clDataField.cstTypeNumber
    End Function
End Class