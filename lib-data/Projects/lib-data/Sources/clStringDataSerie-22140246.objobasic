Public Class clStringDataSerie Inherits clAbstractDataSerie

    Public Constructor(prmSerieName As string)

    Super.Constructor(prmSerieName)
    Self.DefaultValue = ""

    Self.SerieDataType = clDataField.cstTypeString

    Return

    End Constructor
    Public Property DefaultValue As String
    Public Property DataStore() As String
    ## Add one entry set to default value
    Public Sub AppendDefaultItem()

    Self.DataStore.Append(Self.DefaultValue)

    Return

  End Sub
 

    Public Sub AppendItem(prmValue As String)

    Self.DataStore.Append(prmValue)

    Return

    End Sub
    Public Override Function Count() As integer

    Return Datastore.Count
    End Function
    Public Sub SetDefaultValue(prmDefaultValue As string)

    Self.DefaultValue = prmDefaultValue

    Return

    End Sub
    Public Sub ClearDataStore()

    Self.DataStore.Clear()

    return
    End Sub
    Public Function GetType() As string

    Return clDataField.cstTypeString
    End Function
End Class