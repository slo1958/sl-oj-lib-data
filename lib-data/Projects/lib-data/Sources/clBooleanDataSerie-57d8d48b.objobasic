Public Class clBooleanDataSerie Inherits clAbstractDataSerie

    Public Property DataStore() As Boolean
    Public Override Function Count() As integer

    Return Datastore.Count
    End Function
    Public Property DefaultValue As Boolean
    Public Constructor(prmSerieName As string)

    Super.Constructor(prmSerieName)
    Self.DefaultValue = False

    Self.SerieDataType = clDataField.cstTypeBoolean

    Return

    End Constructor
    ## Add one entry set to default value
    Public Sub AppendDefaultItem()

    Self.DataStore.Append(Self.DefaultValue)

    Return

    End Sub
    Public Sub SetDefaultValue(prmDefaultValue As Boolean)

    Self.DefaultValue = prmDefaultValue

    Return

    End Sub
    Public Sub AppendItem(prmValue As Boolean)

    Self.DataStore.Append(prmValue)

    Return

    End Sub
    Public Sub ClearDataStore()

    Self.DataStore.Clear()

    return
    End Sub
    Public Override Function GetDataType() As string

    Return clDataField.cstTypeBoolean
    End Function
End Class