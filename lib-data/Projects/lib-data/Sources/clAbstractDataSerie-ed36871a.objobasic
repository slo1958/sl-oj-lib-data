Public Abstract Class clAbstractDataSerie

    ## Add an entry to the metadata associated with the dataSerie
    Public Sub AppendMetadata(prmWho As string, prmWhat As string)

    If Self.MetaData <> Nothing Then
      Self.MetaData.Add(prmWho, prmWhat)

    End If

    Return

    End Sub
    Public Constructor(prmSerieName As string)

    Self.MetaData = New clMetaData

    Self.FieldDefinition = New clDataField(prmSerieName, clDataField.cstTypeUndefined)

    Return

    End Constructor
    Public Property MetaData As clMetaData
    Public Sub DisplayName(Assigns prmDisplayName As string)

    Self.FieldDefinition.DisplayName = prmDisplayName
    Var msg As String = mdHelpers.ReplaceItems("Update display name of %0 to %1", Self.FieldDefinition.Name(), prmDisplayName)

    Self.MetaData.Add(CurrentMethodName(), msg)

    Return


    End Sub
    Public Function ResizeTo(prmTargetSize As integer) As integer

    If Self.Count() > prmTargetSize Then Return Self.Count()

    While Self.Count() < prmTargetSize
      Self.AppendDefaultItem()

    Wend

    Return Self.Count()



    End Function
    Public Abstract Function Count() As integer
    Public Sub AppendDefaultItem()

    Self.AppendItem(Self.FieldDefinition.DefaultValue)

    Return

    End Sub
    Public Abstract Sub AppendItem(prmValue As object)
    Public Abstract Sub ClearDataStore()
    Protected Property FieldDefinition As clDataField
    Public Function GetDataType() As string

    Return Self.FieldDefinition.DataType()
    End Function
    Public Function DisplayName() As string

    Return Self.FieldDefinition.DisplayName()
    End Function
    Public Function Definition() As clDataField

    Return Self.FieldDefinition.Clone()

    End Function
    Public Abstract Function Element(prmElementIndex As integer) As object
    Public Abstract Sub Element(prmElementIndex As integer, Assigns prmValue As object)
    Public Function Name() As string

    Return Self.FieldDefinition.Name()
    End Function
    Public Abstract Function LastIndex() As integer
End Class