Public Class clBooleanDataSerieOld Inherits clAbstractDataSerie

    Public Property DataStore() As Boolean
    Public Override Function Count() As integer

    Return Datastore.Count
    End Function
    Public Constructor(prmSerieName As string)

    Super.Constructor(prmSerieName)

    Self.FieldDefinition.DefaultValue = False

    Self.FieldDefinition.SetDataType(clDataField.cstTypeBoolean)

    Return

    End Constructor
    Public Sub SetDefaultValue(prmDefaultValue As Boolean)

    Self.FieldDefinition.DefaultValue = prmDefaultValue

    Return

    End Sub
    Public Sub AppendItem(prmValue As Boolean)

    Self.DataStore.Append(prmValue)

    Return

    End Sub
    Public Sub ClearDataStore()

    Self.DataStore.Clear()

    return
    End Sub
    Public Function Element(prmElementIndex As integer) As Object

    Return Self.DataStore[prmElementIndex]
    End Function
    Public Sub Element(prmElementIndex As integer, Assigns prmValue As object)

    Self.DataStore[prmElementIndex] = Boolean(prmValue) 
    End Sub
    Public Sub AppendItem(prmValue As object)

    Self.DataStore.Append(Boolean(prmValue))

    Return

    End Sub
    Public Function LastIndex() As integer

    If DataStore.Count = 0 Then Return -1

    Return DataStore.LastIndex
    End Function
    Public Function Clone() As clBooleanDataSerie

    Var temp As New clBooleanDataSerie("Cloned from " + Self.Name())

    temp.AppendItems(Self.DataStore)

    Return temp

    End Function
    Public Sub AppendItems(prmItems() As Boolean)

    For Each v As Boolean In prmItems
      Self.AppendItem(v)

    Next

    End Sub
End Class