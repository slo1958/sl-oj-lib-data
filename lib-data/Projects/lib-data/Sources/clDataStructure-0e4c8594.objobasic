Public Class clDataStructure

    Private Property FieldsDefinition() As clDataField
    Constructor()

    Return

    End Constructor
    Public Sub AppendField(prmFieldDefinition As clDataField)

    If Self.GetFieldDefinition(prmFieldDefinition.Name()) = Nothing Then

      Self.FieldsDefinition.Append(prmFieldDefinition)

      Return

    Else
      # SHOULD BOUM


    End If


    End Sub
    Public Constructor(prmSourceStructure As clDataStructure)

    Self.FieldsDefinition.Clear()

    For i As Integer = 0 To prmSourceStructure.LastIndex()
      Self.AppendField(prmSourceStructure.GetFieldDefinition(i).Clone())
    Next

    Return

    End Constructor
    Public Function Count() As integer

    Return Self.FieldsDefinition.Count

    End Function
    Public Function LastIndex() As integer

    Return Self.FieldsDefinition.LastIndex

    End Function
    Public Function GetFieldDefinition(prmFieldIndex As integer) As clDataField

    Try
      Return Self.FieldsDefinition[prmFieldIndex]

    Catch dummy As RuntimeException
      Return Nothing

    End Try

    End Function
    ## Return the field definition object of the field matching the name passed as parameter
    Public Function GetFieldDefinition(prmFieldName As String) As clDataField

    For i As Integer = 0 To FieldsDefinition.LastIndex
      If Self.FieldsDefinition[i].Name() = prmFieldName Then Return Self.FieldsDefinition[i]

    Next

    Return Nothing

    End Function
End Class