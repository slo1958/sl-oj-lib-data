Public Class clIntegerDataSerie Inherits clAbstractDataSerie

    Public Property DataStore() As Integer
    Public Override Function Count() As integer

    Return Datastore.Count
    End Function
    Public Property DefaultValue As Integer
    Public Constructor(prmSerieName As string)

    Super.Constructor(prmSerieName)
    Self.DefaultValue = 0

    Self.SerieDataType = clDataField.cstTypeInteger

    return
    End Constructor
    ## Add one entry set to default value
    Public Sub AppendDefaultItem()

    Self.DataStore.Append(Self.DefaultValue)

    Return

    End Sub
    Public Sub SetDefaultValue(prmDefaultValue As Integer)

    Self.DefaultValue = prmDefaultValue

    Return

    End Sub
    Public Sub AppendItem(prmValue As Integer)

    Self.DataStore.Append(prmValue)

    Return

    End Sub
    Public Sub ClearDataStore()

    Self.DataStore.Clear()

    return
    End Sub
    Public Function GetType() As string

    Return clDataField.cstTypeInteger
    End Function
End Class