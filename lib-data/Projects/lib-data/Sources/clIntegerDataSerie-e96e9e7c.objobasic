Public Class clIntegerDataSerie Inherits clAbstractDataSerie

    Public Property DataStore() As Integer
    Public Override Function Count() As integer

    Return Datastore.Count
    End Function
    Public Constructor(prmSerieName As string)

    Super.Constructor(prmSerieName)

    Self.FieldDefinition.DefaultValue = 0

    Self.FieldDefinition.DataType = clDataField.cstTypeInteger

    return
    End Constructor
    Public Sub SetDefaultValue(prmDefaultValue As Integer)

    Self.FieldDefinition.DefaultValue = prmDefaultValue

    Return

    End Sub
    Public Sub AppendItem(prmValue As Integer)

    Self.DataStore.Append(prmValue)

    Return

    End Sub
    Public Sub ClearDataStore()

    Self.DataStore.Clear()

    return
    End Sub
    Public Function Element(prmElementIndex As integer) As Object

    Return Self.DataStore[prmElementIndex]
    End Function
    Public Sub Element(prmElementIndex As integer, Assigns prmValue As object)

    Self.DataStore[prmElementIndex] = Integer(prmValue)
    End Sub
End Class